{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Configurations</h2>

    <section id="configurations">
        
        {% for config in configs %}
            <div class="config">
                <i class="configicon" data-lucide="{{ config.icon }}"></i>

                <h3 class="name"><a href="/configuration/{{ config.id }}">{{ config.name }}</a></h3>

                <div class="details">
                    <div class="cost">
                        <p>${{ config.cost }}</p>
                    </div>
                    <div class="functionbuttons">
                        <a href="/configuration/{{ config.id }}/delete"><i data-lucide="trash"></i></a>
                        <a href="/configuration/{{ config.id }}/edit"><i data-lucide="square-pen"></i></a>  
                    </div>                    
                </div>
            </div>
        {% else %}
            <h3>No configurations</h3>
        {% endfor %}

        

    </section>

<footer id="addconf"><a href="/">Back</a><a href="/configuration/new/mb">Add Configuration</a></footer>
{% endblock %}

