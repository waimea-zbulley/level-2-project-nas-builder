{% extends 'pages/_base.jinja' %}


{% block content %}

    <h1>Configurations</h1>

    <section id="configurations">
        
        {% for config in configs %}
            <div class="config">
                <i class="configIcon" data-lucide="{{ config.icon }}"></i>

                <h2 class="name"><a class="configHover" href="/configuration/{{ config.id }}">{{ config.name }}</a></h2>

                <div class="details">
                    <div class="cost">
                        <p>${{ config.cost | round | int }}</p>
                    </div>
                    <div class="functionButtons">
                        <a aria-label="Edit" class="neutral-hover" href="/configuration/{{ config.id }}/edit"><i data-lucide="square-pen"></i></a>  
                        <a aria-label="Delete" class="negative-hover" href="/configuration/{{ config.id }}/delete"><i data-lucide="trash"></i></a>
                    </div>                    
                </div>
            </div>
        {% else %}
            <h3>No configurations</h3>
        {% endfor %}

    </section>

<footer id="pageFooter"><a class="accent-hover" href="/"><i class="footerIcon" data-lucide="arrow-big-left"></i></a><a class="positive-hover" href="/configuration/new/mb"><i class="footerIcon" data-lucide="plus"></i></a></footer>
{% endblock %}

