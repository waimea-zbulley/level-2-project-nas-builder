{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>NAS Builder</title>

    <link id="pageIcon" rel="icon" href="/static/images/nas.svg">
    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>

        <a href="/" aria-label="Home">
            <i data-lucide="house"></i>
        </a>

        <nav aria-label="Nav Menu">
            <span><i data-lucide="menu" class="nav-icon"></i></span>
            <div class="nav-panel">
                <a href="/configurations">Configurations</a>
                <a href="/components">Components</a>
            </div>
        </nav>
        
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

    <script src="/static/js/configuration.js"></script>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>lucide.createIcons();</script>
    <script src="/static/js/menu.js"></script>

</body>

</html>

