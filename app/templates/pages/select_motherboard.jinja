{% extends "pages/_base.jinja"%}

{% block content %}
    <form id="mbform" method="post" action="/configuration/new/mb">
        <h1>Motherboard & Configuration Name</h1>

        <fieldset class="formitem">
            <div>
                <label>
                    Name:
                    <input type="text" id="name" name="name" minlength="4" maxlength="20" required>
                </label>
                
            </div>
        </fieldset>
        <fieldset class="icon-select">
            <h2>Icon: </h2>
            <div class="icon-options">
                <label>
                    <input required type="radio" name="icon" value="play">
                    <i class="icon" data-lucide="play"></i>
                </label>

                <label>
                    <input required type="radio" name="icon" value="image">
                    <i class="icon" data-lucide="image"></i>
                </label>

                <label>
                    <input required type="radio" name="icon" value="hard-drive">
                    <i class="icon" data-lucide="hard-drive"></i>
                </label>

                <label>
                    <input required type="radio" name="icon" value="server">
                    <i class="icon" data-lucide="server"></i>
                </label>

                <label>
                    <input required type="radio" name="icon" value="cctv">
                    <i class="icon" data-lucide="cctv"></i>
                </label>

                <label>
                    <input required type="radio" name="icon" value="package-search">
                    <i class="icon" data-lucide="package-search"></i>
                </label>
            </div>
            
        </fieldset>

        
        <fieldset class="formitem">
            <label>
                Motherboard:
                <select name="mb">
                    {% for mb in mbs %}
                        <option value="{{ mb.id }}" {% if mb.id == session.mb %} selected {% endif %}>
                            {{ mb.name }} ({{ mb.platform }} socket)
                        </option>
                    {% endfor %}
                </select>
            </label>

        </fieldset>
        
        <footer id="pageFooter"><a class="neutral-hover" href="/"><i class="footerIcon" data-lucide="arrow-big-left"></i></a><button class="positive-hover" type="submit"><i class="footerIcon" data-lucide="arrow-big-right"></i></button></footer>
    </form>

{% endblock %}
