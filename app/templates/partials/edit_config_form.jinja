<form method="post" action="/configuration/{{ config.id }}/edit" id="componentForm">
    {# Hidden form items to store build cost & power to be passed through flask #}
    <input id="totalNum" value="0" type="number" name="cost" readonly hidden>
    <input id="totalPower" value="0" type="number" name="cost" readonly hidden>

    <h1>Edit main components & name</h1>

    {# All IF/ELSE statements are to detect if the component is selected in the configuration so that it can be easily edited #}

    {# Input field for configuration name #}
    <fieldset class="formItem">
        <div>
            <label>
                {# This is to show that the compnent is mandatory (this applys to all other items with this required item class) #}
                <span class="formTitle">Name<span class="requiredItem">*</span></span>  
                <input type="text" id="name" name="name" minlength="4" maxlength="20" value="{{ name }}" required>
            </label>
            
        </div>
    </fieldset>

    {# Radial selection menu for configuration icon #}
    <fieldset class="iconSelect">
        <h2>Icon<span class="requiredItem">*</span> </h2>
            <div class="iconOption">
                {% if config.icon == "play" %}
                    <label><input checked type="radio" name="icon" value="play"><i class="icon" data-lucide="play"></i></label>
                {% else %}
                    <label><input type="radio" name="icon" value="play"><i class="icon" data-lucide="play"></i></label>
                {% endif %}
                {% if config.icon == "image" %}
                    <label><input checked type="radio" name="icon" value="image"><i class="icon" data-lucide="image"></i></label>
                {% else %}
                    <label><input type="radio" name="icon" value="image"><i class="icon" data-lucide="image"></i></label>
                {% endif %}
                {% if config.icon == "hard-drive" %}
                    <label><input checked type="radio" name="icon" value="hard-drive"><i class="icon" data-lucide="hard-drive"></i></label>
                {% else %}
                    <label><input type="radio" name="icon" value="hard-drive"><i class="icon" data-lucide="hard-drive"></i></label>
                {% endif %}
                {% if config.icon == "server" %}
                    <label><input checked type="radio" name="icon" value="server"><i class="icon" data-lucide="server"></i></label>
                {% else %}
                    <label><input type="radio" name="icon" value="server"><i class="icon" data-lucide="server"></i></label>
                {% endif %}
                {% if config.icon == "cctv" %}
                    <label><input checked type="radio" name="icon" value="cctv"><i class="icon" data-lucide="cctv"></i></label>
                {% else %}
                    <label><input type="radio" name="icon" value="cctv"><i class="icon" data-lucide="cctv"></i></label>
                {% endif %}
                {% if config.icon == "package-search" %}
                    <label><input checked type="radio" name="icon" value="package-search"><i class="icon" data-lucide="package-search"></i></label>
                {% else %}
                    <label><input type="radio" name="icon" value="package-search"><i class="icon" data-lucide="package-search"></i></label>
                {% endif %}            
            </div>
    </fieldset>

    {# Field to show bootdrive #}
    <fieldset class="bootdrive"> 
        <label>
            <span class="formTitle">Boot Drive<span class="requiredItem">*</span></span> 
            <p>{{ ssds[0].name }} - ${{ ssds[0].cost }}</p>
        </label>
    </fieldset>


    {# CPU form option #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">CPU<span class="requiredItem">*</span></span>
            <select id="cpu" name="cpu" class="priced power" required >
                {% for cpu in cpus %}
                    {# If statement to determine which cpu is currently selected in the configuration, so it can be edited. The same principle can be applied to the rest of components :) #}
                    {% if cpu.id == config.cpu %}
                        <option value="{{ cpu.id }}" data-power="{{ cpu.powerdraw }}" data-price="{{ cpu.cost }}" selected>{{ cpu.name }} - ${{ cpu.cost }}</option>
                    {% else %}
                        <option value="{{ cpu.id }}" data-power="{{ cpu.powerdraw }}" data-price="{{ cpu.cost }}">{{ cpu.name }} - ${{ cpu.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>
    </fieldset>

    {# Select field for CPU Cooler #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">CPU Cooler<span class="requiredItem">*</span></span> 
            <select id="coolers" name="cooler" class="priced" required>
                {% for cooler in coolers %}
                    {% if cooler.id == config.cooler %}
                        <option value="{{ cooler.id }}"  data-price="{{ cooler.cost }}" selected>{{ cooler.name }} - ${{ cooler.cost }}</option>
                    {% else %}
                        <option value="{{ cooler.id }}"  data-price="{{ cooler.cost }}">{{ cooler.name }} - ${{ cooler.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>
    </fieldset>

    {# RAM form option #}
    <fieldset class="multiFormItem">
        <label class="multiItem">
            <span class="formTitle">RAM<span class="requiredItem">*</span></span>
            <select id="ram"  name="ram" class="priced" required >
                {% for ram in ram %}
                    {% if ram.id == config.ram %}
                        <option value="{{ ram.id }}" data-price="{{ ram.cost }}" selected>{{ ram.name }} - ${{ ram.cost }}</option>
                    {% else %}
                        <option value="{{ ram.id }}" data-price="{{ ram.cost }}">{{ ram.name }} - ${{ ram.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>

        <label class="quantityitem">
            <span class="formTitle">QTY<span class="requiredItem">*</span></span>
            <input type="number" name="ramqty" class="quantity" id="ramqty" value="{{ config.ram_qty }}" max="{{ mb.ram_slots }}" min="1">
            <span class="maxQuantity">Max: {{ config.ram_qty }}</span>
        </label>
    </fieldset>

    {# Select field for Hard Drive #}
    <fieldset class="multiFormItem">
        <label class="multiItem">
            Hard Drive
            <select id="hdd"  name="hdd" class="priced hdd">
                <option value="" data-price="0">None</option>
                {% for hdd in hdds %}
                    {% if hdd.id == config.hard_drive %}
                        <option value="{{ hdd.id }}" data-hdd="{{ hdd.capacity }}" data-price="{{ hdd.cost }}" selected>{{ hdd.name }} - ${{ hdd.cost }}</option>
                    {% else %}
                        <option value="{{ hdd.id }}" data-hdd="{{ hdd.capacity }}" data-price="{{ hdd.cost }}">{{ hdd.name }} - ${{ hdd.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>  
        </label>

        {# Quantity for HDD #}
        <label class="quantityitem">
            QTY
            <input type="number" name="hddqty" value="{{ config.hard_drive_qty }}" class="quantity" id="hddqty" max="{{ mb.sata_ports }}" min="0">
            <span class="maxQuantity">Max: {{ config.hard_drive_qty }}</span>
        </label>

    </fieldset>

    {# Select field for SSD #}
    <fieldset class="multiFormItem">
        <label class="multiItem">
            SSD
            <select id="ssd"  name="ssd" class="priced">
                <option value="" data-price="0">None</option>
                {% for ssd in ssds %}
                    {% if ssd.id == config.solid_drive %}
                        <option value="{{ ssd.id }}" data-price="{{ ssd.cost }}" selected>{{ ssd.name }} - ${{ ssd.cost }}</option>
                    {% else %}
                        <option value="{{ ssd.id }}" data-price="{{ ssd.cost }}">{{ ssd.name }} - ${{ ssd.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>  
        </label>

        {# Quantity for SSD #}
        <label class="quantityitem">
            QTY
            <input type="number" value="{{ config.solid_drive_qty }}" class="quantity" name="ssdqty" id="ssdqty" max="{{ mb.m2_ports }}" min="0">
            <span class="maxQuantity">Max: {{ config.solid_drive_qty }}</span>
        </label>
    </fieldset>

    {# Select Option for Graphics card #}
    <fieldset class="formItem">
        <label>
            Graphics Card
            <select id="gpu" name="gpu" class="priced power">
                <option value="" data-power="0" data-price="0">None</option>
                {% for gpu in gpus%}
                    {% if gpu.id == config.gpu %}
                        <option value="{{ gpu.id }}" data-power="{{ gpu.powerdraw }}" data-price="{{ gpu.cost }}" selected>{{ gpu.name }} - ${{ gpu.cost }}</option>
                    {% else %}
                        <option value="{{ gpu.id }}" data-power="{{ gpu.powerdraw }}" data-price="{{ gpu.cost }}">{{ gpu.name }} - ${{ gpu.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>    
    </fieldset>

    {# Drop down selection for CASES #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">Case<span class="requiredItem">*</span></span>
            <select id="cases" name="case" class="priced" required>
                <option value="" data-price="0">-- choose one --</option>
                {% for case in cases %}
                    {% if case.id == config.case %}
                        <option value="{{ case.id }} "  data-price="{{ case.cost }}" selected>{{ case.name }} - ${{ case.cost }}</option>
                    {% else %}
                        <option value="{{ case.id }} "  data-price="{{ case.cost }}">{{ case.name }} - ${{ case.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>  
    </fieldset>



    {# Drop down selection for Network Cards #}
    <fieldset class="formItem">
        <label>
            Network Card
            <select id="nwcards" name="nwcard" class="priced ">
                <option value="" data-price="0">None</option>
                {% for nwcard in nwcards %}
                    {% if nwcard.id == config.network_card%}
                        <option value="{{ nwcard.id }} "  data-price="{{ nwcard.cost }}" selected>{{ nwcard.name }} - ${{ nwcard.cost }}</option>
                    {% else %}
                        <option value="{{ nwcard.id }} "  data-price="{{ nwcard.cost }}">{{ nwcard.name }} - ${{ nwcard.cost }}</option>
                    {% endif %}
                {% endfor %}
            </select>

        </label>
    </fieldset>
    

    <footer id="pageFooter"><div class="footerCost"><p>Cost</p><p>$<span id="total">0.00</span></p></div><button class="positive-hover" type="submit"><i class="footerIcon" data-lucide="arrow-big-right"></i></button></footer>
</form>