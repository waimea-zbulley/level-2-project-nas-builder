<form method="post" action="/configuration/new/final" id="componentForm">
    <h1>Final Steps</h1>
    {# Hidden form item to pass through cost to flask #}
    <input id="totalNum" value="0" type="number" name="cost" hidden readonly>

    {# Field for powersupply selection #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">Powersupply<span class="requiredItem">*</span>
                <span title="A powersupply is what supplies the power to the components within your build. You can only select compatable powersupplys from this menu"><i data-lucide="info"></i></span>
            </span>
            <select name="psu" required class="priced">
                <option value="" data-price="0" disabled selected> --Choose One-- </option>
                {% for psu in psus %}
                    <option value="{{ psu.id }}" data-price="{{ psu.cost }}">{{ psu.name }}</option>
                {% endfor %}
            </select>
        </label>
    </fieldset>

    {# Field for Operating system selection #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">Operating System<span class="requiredItem">*</span>
                <span title="An operating system is the software that the build will run. TrueNAS is a free software good for most thing, some users may want to use Unraid to expand thier capabilites."><i data-lucide="info"></i></span>
            </span>
            <select name="os" required class="priced">
                <option value="" data-price="0" disabled selected> --Choose One-- </option>
                {% for os in oses %}
                    <option value="{{ os.id }}" data-price="{{ os.cost }}">{{ os.name }}</option>
                {% endfor %}
            </select>
        </label>
    </fieldset>

    {# Page fotoer for navigation #}
    <footer id="pageFooter"><div class="footerCost"><p>Cost</p><p>$<span id="total">0.00</span></p></div><button class="positive-hover" type="submit"><i class="footerIcon" data-lucide="check-line"></i></button></footer>
</form>