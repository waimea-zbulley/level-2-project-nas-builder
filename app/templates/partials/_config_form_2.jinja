<form method="post" action="/configuration/new/components" id="componentForm"> 
    <h1>Main Components</h1>

    {# Hidden form items to store cost and power draw to pass through to flask. As well as boot drive #}
    <input id="totalNum" value="0" type="number" name="cost" readonly hidden>
    <input id="totalPower" value="0" type="number" name="cost" readonly hidden>
    <select hidden class="priced" id="bootDrive"><option data-price="{{ ssds[0].cost }}" value="{{ ssds[0].id }}" >{{ ssds[0].name }} - ${{ ssds[0].cost }}</option></select>

    {# Field to show Bootdrive #}
    <fieldset class="bootdrive"> 
        <label>
            <span class="formTitle">Boot Drive<span class="requiredItem">*</span>
                <span title="The boot drive is the device that the system will boot off, this device is picked for you as it is not relevant to your system."><i data-lucide="info"></i></span>
            </span>
            <span class="bootName">{{ ssds[0].name }} - ${{ ssds[0].cost }}</span>
        </label>
    </fieldset>

    {# Cpu form option #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">CPU<span class="requiredItem">*</span>
                <span title="The CPU is the main processor of the system, this is important for faster file transfers and some other intense tasks. For general storage virtualy any CPU will be totaly fine"><i data-lucide="info"></i></span>
            </span>
            <select id="cpu" name="cpu" class="priced power" required >
                <option value="" data-power="0" data-price="0" disabled selected >-- choose one --</option>
                {% for cpu in cpus %}
                    <option value="{{ cpu.id }}" data-power="{{ cpu.powerdraw }}" data-price="{{ cpu.cost }}">{{ cpu.name }} - ${{ cpu.cost }}</option>
                {% endfor %}
            </select>
        </label>
    </fieldset>

    {# Select field for CPU Cooler #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">CPU Cooler<span class="requiredItem">*</span>
                <span title="The CPU cooler is the device that ensures that the CPU's temperature stays under controll, a more expensive CPU Cooler would be recomended with a better CPU"><i data-lucide="info"></i></span>
            </span>
            <select id="coolers" name="cooler" class="priced" required>
                <option value="" data-price="0" disabled selected >-- choose one --</option>
                    {% for cooler in coolers %}
                        <option value="{{ cooler.id }}"  data-price="{{ cooler.cost }}">{{ cooler.name }} - ${{ cooler.cost }}</option>
                    {% endfor %}
            </select>
        </label>
    </fieldset>


    {# RAM form option #}
    <fieldset class="multiFormItem">
        <label class="multiItem">
            <span class="formTitle">RAM<span class="requiredItem">*</span>
                    <span title="RAM is the component that keeps the data of any actively running tasks, ram is important for ensuring files are readily accesable quickly. A larger amount of ram would be recomended for a NAS for tasks such as video editing files."><i data-lucide="info"></i></span>
            </span>
            <select id="ram"  name="ram" class="priced" required >
                <option value="" data-price="0" disabled selected >-- choose one --</option>
                {% for ram in ram %}
                    <option value="{{ ram.id }}" data-price="{{ ram.cost }}">{{ ram.name }} - ${{ ram.cost }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            <span class="formTitle">QTY<span class="requiredItem">*</span></span>
            <input type="number" name="ramqty" class="quantity" id="ramqty" value="1" max="{{ mb.ram_slots }}" min="1">
            <span class="maxQuantity">Max: {{ mb.ram_slots  }}</span>
        </label>
    </fieldset>

    {# Select field for HDD #}
    <fieldset class="multiFormItem">
        <label class="multiItem">
            <span class="formTitle">Hard Drive
                <span title="The hard drive is a form of storage, hard drives are typically a cheaper storage option these days but come in larger storage sizes with the trade off of being a bit slower than other options (Solid state drives)."><i data-lucide="info"></i></span>
            </span> 
            <select id="hdd"  name="hdd" class="priced hdd">
                <option value="" data-price="0" >None</option>
                {% for hdd in hdds %}
                    <option value="{{ hdd.id }}" data-hdd="{{ hdd.capacity }}" data-price="{{ hdd.cost }}">{{ hdd.name }} - ${{ hdd.cost }}</option>
                {% endfor %}
            </select>  
        </label>

        {# Quantity for HDD #}
        <label>
            QTY
            <input type="number" name="hddqty" class="quantity" id="hddqty" value="0" max="{{ mb.sata_ports }}" min="0">
            <span class="maxQuantity">Max: {{ mb.sata_ports }}</span>
        </label>
        {# <label>Total Capacity<input id="totalHddStorage" value="0" type="number" name="totalHddStorage" readonly></label> #}

    </fieldset>

    {# Select field for SSD #}
    <fieldset class="multiFormItem">
        <label class="multiItem">
            <span class="formTitle">SSD
                <span title="An SSD is a form of storage which is considerbly more expensive than hard drives but also has major speed and relability benifits making it a good choice for NAS's for things such as video editing NAS. SSD's are unecassary for general storage"><i data-lucide="info"></i></span>
            </span> 
            <select id="ssd"  name="ssd" class="priced">
                <option value="" data-price="0">None</option>
                {% for ssd in ssds %}
                    <option value="{{ ssd.id }}" data-price="{{ ssd.cost }}">{{ ssd.name }} - ${{ ssd.cost }}</option>
                {% endfor %}
            </select>  
        </label>

        <label>
            QTY
            <input type="number" class="quantity" name="ssdqty" value="0" id="ssdqty" max="{{ mb.m2_ports }}" min="0">
            <span class="maxQuantity">Max: {{ mb.m2_ports }}</span>
        </label>
    </fieldset>

    {# Select field for grahpics card #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">Graphics Card
                <span title="A graphics card is a form of processor good specificly for graphical tasks. A graphics card is only really necassry if you intend to run intense workloads on your NAS such as rendering."><i data-lucide="info"></i></span>
            </span> 
            <select id="gpu" name="gpu" class="priced power">
                <option value="" data-power="0" data-price="0">None</option>
                {% for gpu in gpus%}
                    <option value="{{ gpu.id }}" data-power="{{ gpu.powerdraw }}" data-price="{{ gpu.cost }}">{{ gpu.name }} - ${{ gpu.cost }}</option>
                {% endfor %}
            </select>
        </label>
    </fieldset>
    

    {# Drop down selection for CASES #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">Case<span class="requiredItem">*</span></span>
            <select id="cases" name="case" class="priced" required>
                <option value="" data-price="0" disabled selected >-- choose one --</option>
                {% for case in cases %}
                    <option value="{{ case.id }} "  data-price="{{ case.cost }}">{{ case.name }} - ${{ case.cost }}</option>
                {% endfor %}
            </select>
        </label>
    </fieldset>
    


    {# Drop down selection for Network Cards #}
    <fieldset class="formItem">
        <label>
            <span class="formTitle">Network Card
                <span title="A network card is a device which allows you to add more network ports to your NAS usally with a higher speed than the avalible port on the motherboard"><i data-lucide="info"></i></span>
            </span> 
            <select id="nwcards" name="nwcard" class="priced">
                <option value="" data-price="0">None</option>
                {% for nwcard in nwcards %}
                    <option value="{{ nwcard.id }} "  data-price="{{ nwcard.cost }}">{{ nwcard.name }} - ${{ nwcard.cost }}</option>
                {% endfor %}
            </select>

        </label>
    </fieldset>

    <footer id="pageFooter"><div class="footerCost"><p>Cost</p><p>$<span id="total">0.00</span></p></div><button class="positive-hover" type="submit"><i class="footerIcon" data-lucide="arrow-big-right"></i></button></footer>
</form>