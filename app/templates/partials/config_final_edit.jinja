<form method="post" action="/configuration/{{ config.id }}/final/edit" id="componentForm">
    <h1>Edit Powersupply & Operating System</h1>
    <input id="totalNum" value="0" type="number" name="cost" readonly hidden>
    <fieldset class="formitem">
        <label>
            Powersupply
            <select name="psu" required class="priced">
                {% for psu in psus %}
                    {# If statement to retrive the currently selected psu from the old config. 
                    Note: If the psu is not compatible it will not be passed through (therefore the blank option will be selected) #}
                    {% if psu.id == config.psu %}
                        <option value="{{ psu.id }}" data-price="{{ psu.cost }}" selected>{{ psu.name }}</option>
                    {% else %}
                        <option value="{{ psu.id }}" data-price="{{ psu.cost }}">{{ psu.name }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>
    </fieldset>
    <fieldset class="formitem">
        <label>
            Operating System
            <select name="os" required class="priced">
                {% for os in oses %}
                    {% if os.id == config.os %}
                        <option value="{{ os.id }}" data-price="{{ os.cost }}" selected>{{ os.name }}</option>
                    {% else %}
                        <option value="{{ os.id }}" data-price="{{ os.cost }}">{{ os.name }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </label>
    </fieldset>

    <footer id="pageFooter"><div class="footerCost"><p>Cost</p><p>$<span id="total">0.00</span></p></div><button class="positive-hover" type="submit"><i class="footerIcon" data-lucide="check-line"></i></button></footer>


</form>