<select hidden class="priced" id="bootDrive"><option data-price="{{ ssds[0].cost }}" value="{{ ssds[0].id }}" >{{ ssds[0].name }} - ${{ ssds[0].cost }}</option></select>
<select name="cpu" id="cpu" class="priced" hidden><option value="{{ cpu.id }}" data-price="{{ cpu.cost }}">CPU</option></select>
<fieldset hidden>
    <select name="ram" id="ram" class="priced" hidden><option value="{{ ram.id }}" data-price="{{ ram.cost }}">RAM</option></select>
    <input type="number" name="ramqty" class="quantity" value="{{ ram_qty }}" hidden>
</fieldset>
<fieldset hidden>
    <select name="hdd" id="hdd" class="priced" hidden><option value="{{ hdd.id }}" data-price="{{ hdd.cost }}">HDD</option></select>
    <input type="number" name="hddqty" class="quantity" value="{{ hdd_qty }}" hidden>
</fieldset>
<fieldset hidden>
    <select name="ssd" id="ssd" class="priced" hidden><option value="{{ ssd.id }}" data-price="{{ ssd.cost }}">HDD</option></select>
    <input type="number" name="ssdqty" class="quantity" value="{{ ssd_qty }}" hidden>
</fieldset>
<select name="gpu" id="gpu" class="priced" hidden><option value="{{ gpu.id }}" data-price="{{ gpu.cost }}">GPU</option></select>
<select name="cooler" id="cooler" class="priced" hidden><option value="{{ cooler.id }}" data-price="{{ cooler.cost }}">Cooler</option></select>
<select name="nwcard" id="nwcard" class="priced" hidden><option value="{{ nwcard.id }}" data-price="{{ nwcard.cost }}">Nwcard</option></select>
<select name="case" id="case" class="priced" hidden><option value="{{ case.id }}" data-price="{{ case.cost }}">Case</option></select>
